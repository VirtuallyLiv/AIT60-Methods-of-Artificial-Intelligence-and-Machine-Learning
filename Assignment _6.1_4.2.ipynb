# Step 1: Import necessary libraries

 #Pandas: Useful for data manipulation, reading CSV files, and handling dataframes
import pandas as pd

#LabelEncoder: Transforms categorical text labels into integer numerical values (0,1,2, ...)
from sklearn.preprocessing import LabelEncoder

#train_test_split: splits data into random train and test subsets for unbiased model testing
from sklearn.model_selection import train_test_split

from sklearn.ensemble import RandomForestClassifier, ExtraTreesClassifier
from sklearn.metrics import confusion_matrix, classification_report

# load dataset
# R prefix creates a raw string to safely handle backslashes in Windows file paths
df = pd.read_csv(r"C:\Users\Olivia Nkweto\Downloads\car.csv")


# Step 2: perform label encoding with LabelEncoder()
le = LabelEncoder()
label_mappings = {}

for col in df.columns:
    #fit_transform creates the.classes_ attribute for this column
    df[col] = le.fit_transform(df[col])
    label_mappings[col] = dict(zip(le.classes_, range(len(le.classes_))))

    # Target class mapping: {0: 'acc', 1: 'good',2: 'unacc', 3: 'vgood'}
target_names = list(label_mappings['class'].keys())

# Step 3: Extract the label variable using pop
# Extract the label variable using pop () from pandas

y = df.pop('class')
x = df

# Separate training and testing data with train_test_split() (10% test data)
x_train, x_test, y_train, y_test = train_test_split(x, y, test_size=0.10, random_state=42)

#Random Forest Classifier

print("=" * 60)
print("1. RANDOM FOREST CLASSIFIER")
print("=" * 60)

# Step 2 & 3: create and train a random forest classifier
rf_model =RandomForestClassifier(random_state=42)
rf_model.fit(x_train, y_train)

# predictions
rf_pred = rf_model.predict(x_test)

# Step 4: evaluate the random forest using confusion_matrix ()
print("Confusion Matrix:")
print(confusion_matrix(y_test, rf_pred))
print ()

# Step 5: Classification report using classification_report()
print("Classification Report:")
print(classification_report(y_test, rf_pred, target_names=target_names))

# Step 6: Feature Importance using .feature_importances_
rf_importances = pd.Series(rf_model.feature_importances_, index=x.columns).sort_values(ascending=False)
print("Feature Importances:")
print(rf_importances.to_string())
print("\n")

# Step 7: Extra trees classifier Repeat step 2 -6
print("=" * 60)
print("2. EXTRA TREES (EXTREMELY RANDOMIZED TREES) CLASSIFIER")
print("=" * 60)

#Create & train extra trees classifier
et_model = ExtraTreesClassifier(random_state=42)
et_model.fit(x_train, y_train)

# predictions
et_pred = et_model.predict(x_test)

# Confusion matrix
print("Confusion Matrix:")
print(confusion_matrix(y_test, et_pred))
print()

# Classification Report
print("Classification Report:")
print(classification_report(y_test, et_pred, target_names=target_names))

# Feature Importance
et_importances = pd.Series(et_model.feature_importances_, index=x.columns).sort_values(ascending=False)
print("Feature Importances:")
print(et_importances.to_string())

      