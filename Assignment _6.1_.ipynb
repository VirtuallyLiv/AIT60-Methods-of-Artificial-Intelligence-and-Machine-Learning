#===============================================================================================================================
# Step 1:Import necessary libraries
#===============================================================================================================================

#Pandas: Useful for data manipulation, reading CSV files, and handling dataframes
import pandas as pd

#LabelEncoder: Transforms categorical text labels into integer numerical values (0,1,2, ...)
from sklearn.preprocessing import LabelEncoder

#train_test_split: splits data into random train and test subsets for unbiased model testing
from sklearn.model_selection import train_test_split

#DecisionTreeClassifier: The core machine learning algorithm that builds rule-based decision trees
from sklearn.tree import DecisionTreeClassifier

# Classification_report: generates detailed metrics (precision, recall, F1-score) per class
from sklearn.metrics import classification_report

#======================================================================================================================================================
# Step 2: Upload dataset
#======================================================================================================================================================
#Read the car dataset into a pandas DataFrame.
# R prefix creates a raw string to safely handle backslashes in Windows file paths
df = pd.read_csv(r"C:\Users\Olivia Nkweto\Downloads\car.csv")

# print the first 5 rows to inspect raw dataset values
print("--- Raw Dataset Output ---")
print(df.head())
print("\n" + "=" *50 + "\n")
#======================================================================================================================================================
# Step 3: Feature processing 
#======================================================================================================================================================
# Perform label encoding with LabelEncoder() from scikit-learn
le = LabelEncoder()
label_mappings = {}

for col in df.columns:
    #fit_transform creates the.classes_ attribute for this column
    df[col] = le.fit_transform(df[col])
    label_mappings[col] = dict(zip(le.classes_, range(len(le.classes_))))

# Target class mapping: {0: 'acc', 1: 'good',2: 'unacc', 3: 'vgood'}
target_names = list(label_mappings['class'].keys())

#======================================================================================================================================================
#Step 4: Separate feature and target labels
#======================================================================================================================================================
# Extract the label variable using pop () from pandas

y = df.pop('class')
x = df

#=====================================================================================================================================================
#Step 5: Split data into training and testing sets
#======================================================================================================================================================
# Separate training and testing data with train_test_split() (10% test data)
x_train, x_test, y_train, y_test = train_test_split(x, y, test_size=0.10, random_state=42)

#======================================================================================================================================================
# Step 6: train and predict with decision tree classifier
#======================================================================================================================================================
# Build a decision tree classifier using DecisionTreeClassifier(), fit(), and predict()
model = DecisionTreeClassifier(random_state=42)
model.fit(x_train, y_train)

y_pred = model.predict(x_test)

#======================================================================================================================================================
# Step 7
#======================================================================================================================================================
# Check the score of our model based on test data with score()
test_score = model.score(x_test, y_test)
print(f"Model Accuracy (score): {test_score * 100:.2f}%\n")

# Create a deeper evaluation of the model using classification_report()
print("--- Classification Report ---")
print(classification_report(y_test, y_pred, target_names=target_names))